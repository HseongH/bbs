{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "dev": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "lint": "ng lint && prettier --check .",
    "lint:fix": "ng lint --fix && prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "e2e": "playwright test",
    "gen:api": "openapi-typescript http://localhost:8080/v3/api-docs -o src/app/core/api/schema.d.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm build && pnpm test"
  },
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "dependencies": {
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/router": "^22.2.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.5.0",
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/angular": "^19.5.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.7",
    "angular-eslint": "22.5.0",
    "eslint": "^10.12.0",
    "jsdom": "^28.0.0",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.29",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.1",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": ">=24.18.0"
  }
}
