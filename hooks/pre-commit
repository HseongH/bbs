#!/bin/sh

./gradlew spotlessCheck checkstyleMain -q

if [ $? -ne 0 ]; then
    echo ""
    echo "❌ Code quality check failed."
    echo "Run './gradlew spotlessApply' to format the code."
    exit 1
fi

if git diff --cached --name-only | grep -q '^services/web/'; then
    (cd services/web && pnpm lint && pnpm typecheck)

    if [ $? -ne 0 ]; then
        echo ""
        echo "❌ Frontend check failed."
        echo "Run 'cd services/web && pnpm lint:fix' to format the code."
        exit 1
    fi
fi

exit 0
