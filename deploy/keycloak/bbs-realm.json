{
  "realm": "bbs",
  "enabled": true,
  "displayName": "BBS",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "sslRequired": "none",
  "roles": {
    "realm": [
      {
        "name": "USER",
        "description": "일반 사용자"
      },
      {
        "name": "ADMIN",
        "description": "관리자"
      }
    ]
  },
  "clients": [
    {
      "clientId": "bbs-app",
      "name": "게시판 애플리케이션",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "bbs-app-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://__BBS_HOST__:8080/*",
        "http://__BBS_HOST__:5173/*"
      ],
      "webOrigins": [
        "http://__BBS_HOST__:8080",
        "http://__BBS_HOST__:5173"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://__BBS_HOST__:8080/*##http://__BBS_HOST__:5173/*"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "tester",
      "enabled": true,
      "emailVerified": true,
      "email": "tester@example.com",
      "firstName": "테스트",
      "lastName": "사용자",
      "credentials": [
        {
          "type": "password",
          "value": "tester",
          "temporary": false
        }
      ],
      "realmRoles": [
        "USER"
      ]
    },
    {
      "username": "admin-user",
      "enabled": true,
      "emailVerified": true,
      "email": "admin@example.com",
      "firstName": "관리",
      "lastName": "사용자",
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": [
        "USER",
        "ADMIN"
      ]
    }
  ]
}
