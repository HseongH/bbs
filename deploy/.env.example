# 개발 환경 변수. 바꿀 값만 이 파일을 deploy/.env로 복사해서 적는다. .env가 없으면 아래 기본값을 쓴다.
# deploy/.env는 Git에 올리지 않는다.

# PostgreSQL. board는 Spring의 docker compose 연동이 컨테이너 설정에서 접속 정보를 읽으므로 따로 바꿀 필요가 없다.
POSTGRES_DB=bbs
POSTGRES_USER=bbs
POSTGRES_PASSWORD=bbs

# Keycloak 관리 콘솔(localhost:8081)의 관리자 계정
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# 포트를 열 주소. 기본값은 이 PC에서만 접속할 수 있다.
BIND_ADDRESS=127.0.0.1

# Keycloak 포트만 따로 열 주소. 다른 기기(휴대폰 등)에서 로그인해야 할 때만 0.0.0.0으로 바꾼다.
# 비우면 BIND_ADDRESS를 따른다. DB와 Valkey까지 열리지 않도록 BIND_ADDRESS 대신 이 값을 쓴다.
KEYCLOAK_BIND_ADDRESS=

# BBS_HOST(다른 기기에서 접속할 주소)는 이 파일에 적지 않는다. compose뿐 아니라 board와 E2E도 같은 값을
# 읽어야 하므로 셸에서 export한다 (README의 "다른 주소로 접속" 참고).
